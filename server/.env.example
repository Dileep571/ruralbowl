# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ruralbowl_db
DB_USER=postgres
DB_PASSWORD=your_secure_db_password_here
DB_POOL_MAX=20

# JWT Configuration (CRITICAL: Change these in production!)
# Generate JWT_SECRET with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_this_to_a_very_long_random_string_min_64_characters
JWT_EXPIRE=15m
# Refresh token expiry in days (used for httpOnly cookie refresh tokens)
REFRESH_TOKEN_EXPIRE_DAYS=30

# Frontend URL (for CORS)
# Development: http://localhost:3000
# Production: https://yourdomain.com
FRONTEND_URL=http://localhost:3000

# Email Configuration (Gmail App Password)
# IMPORTANT: Generate an App Password (NOT your Gmail password)
# 
# Setup Instructions:
# 1. Go to https://myaccount.google.com/security
# 2. Enable 2-Factor Authentication first (required)
# 3. Search for "App passwords" → https://myaccount.google.com/apppasswords
# 4. Select "Mail" app and "Other" device, name it "RuralBowl"
# 5. Copy the 16-character password (format: xxxx xxxx xxxx xxxx)
# 6. Paste below WITHOUT spaces (e.g., abcdefghijklmnop)
#
# Email Notifications Sent:
# → Welcome email on user signup
# → Order confirmation after checkout
# → Payment confirmation receipt
# → Shipping notification with tracking
# → Delivery confirmation
# → Order status updates
# → Order cancellation & refund info
# → Password reset links
# → Admin: New order alerts
# → Admin: Low stock alerts
#
# Leave blank to disable all email notifications
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-16-char-app-password-here
ADMIN_EMAIL=admin@ruralbowl.com

# Payment Gateway (Razorpay) - Optional
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Image Upload (Cloudinary) - REQUIRED for product images
# Get free account at: https://cloudinary.com/users/register_free
# Find credentials at: https://console.cloudinary.com/console
# Free tier: 25GB storage + 25GB bandwidth/month
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here
